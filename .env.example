# RSS-Tracker configuration
# Copy to .env and fill in.

# Required: Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=

# SQLite database file (created automatically)
DB_PATH=./data/rss-tracker.db

# Default feed interval in minutes (minimum 2)
DEFAULT_INTERVAL_MINUTES=10

# Delay in ms between two messages sent to the same channel
SEND_DELAY_MS=1000

# Log level: trace|debug|info|warn|error
LOG_LEVEL=info

# Auto-backup hour (0-23, local time). Empty to disable.
BACKUP_HOUR=3

# Auto-backup retention: number of daily backup files kept in data/backups/
BACKUP_RETENTION_DAYS=7

# Consecutive feed failures before an alert is sent (per-channel override via /settings alert)
FAILURE_ALERT_THRESHOLD=3

# Timezone used for {date} placeholder when a feed has no locale set (IANA name)
TIMEZONE=UTC

# UID/GID used to run the container (docker compose) — should match the owner
# of the ./data bind mount directory (check with: id -u && id -g)
LOCAL_UID=1000
LOCAL_GID=1000
