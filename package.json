{
  "name": "rss-tracker",
  "version": "1.0.5",
  "description": "Lightweight self-hosted Discord RSS bot (MonitoRSS alternative)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "test": "vitest run",
    "backup": "tsx src/cli/backup.ts",
    "restore": "tsx src/cli/restore.ts",
    "import": "tsx src/cli/import.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.27.0",
    "feedsmith": "^3.0.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
